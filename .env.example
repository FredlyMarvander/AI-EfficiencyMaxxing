# Example shell variables for local testing. Do not bake secrets into Docker.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
ALLOWED_MODELS=accounts/fireworks/models/kimi-k2p7-code

# Optional overrides:
INPUT_PATH=/input/tasks.json
OUTPUT_PATH=/output/results.json
MAX_TOKENS=
REQUEST_TIMEOUT_SECONDS=30
# Keep in sync with DEFAULT_MAX_RUNTIME_SECONDS in agent/config.py so local
# testing exercises the same deadline behavior the harness will see.
MAX_RUNTIME_SECONDS=540