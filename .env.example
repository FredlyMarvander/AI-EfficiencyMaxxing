# Example shell variables for local testing. Do not bake secrets into Docker.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# Comma-separated Fireworks model IDs. The harness injects the official list
# at evaluation time; for local testing use models your key can access, e.g.
# accounts/fireworks/models/llama-v3p1-8b-instruct
ALLOWED_MODELS=

# Optional overrides:
INPUT_PATH=/input/tasks.json
OUTPUT_PATH=/output/results.json
MAX_TOKENS=
REQUEST_TIMEOUT_SECONDS=30
MAX_RUNTIME_SECONDS=540
FIREWORKS_CONCURRENCY=4

# FIREWORKS_MIN_INTERVAL sets a floor (seconds) between requests. The client
# also auto-paces itself on top of this based on observed 429 responses, so
# 0 (default) is safe even on a rate-limited key -- it just takes a couple of
# 429s to converge. Set a floor only to skip that initial learning period.
FIREWORKS_MIN_INTERVAL=0

# Routing toggles:
# ENABLE_LOCAL_MODEL=0 sends every non-deterministic task to Fireworks.
# ENABLE_DETERMINISTIC=0 disables the zero-token local solvers
# (pure arithmetic, "X% of Y", "average of ...", single-variable linear
# equations, temperature conversions).
ENABLE_LOCAL_MODEL=1
ENABLE_DETERMINISTIC=1
